 			SSH_RELEASE, SSH_OPENSSL_VERSION, SWZ_MANAGED_OPENSSH_BASELINE);
 		exit(0);
@@ -1385,7 +1412,9 @@ main(int ac, char **av)
 		default:
 			usage();
 			break;
 		}
 	}
