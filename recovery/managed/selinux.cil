(block swz_recovery
    (type swz_recovery_t)
    (type swz_recovery_exec_t)
    (type swz_recovery_var_t)
    (type swz_recovery_socket_t)
    (typeattribute swz_recovery_t domain)
    (typeattribute swz_recovery_exec_t file_type)
    (typeattribute swz_recovery_var_t file_type)
    (typeattribute swz_recovery_socket_t file_type)
    (allow swz_recovery_t swz_recovery_exec_t (file (read execute open getattr map)))
    (allow swz_recovery_t swz_recovery_var_t (dir (search read getattr open)))
    (allow swz_recovery_t swz_recovery_var_t (file (read write create getattr open append setattr)))
    (allow swz_recovery_t swz_recovery_socket_t (sock_file (create read write getattr open setattr)))
    (allow swz_recovery_t self (process (fork transition sigchld signal getattr)))
    (allow swz_recovery_t self (unix_stream_socket (create read write getattr connectto accept)))
)
