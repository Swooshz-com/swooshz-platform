(block swz_recovery
  (type swz_sshd_t)
  (type swz_supervisor_t)
  (type swz_custodian_t)
  (type swz_dispatcher_t)
  (type swz_bootstrap_t)
  (type swz_broker_t)
  (type swz_agent_t)
  (type swz_recovery_runtime_t)
  (type swz_recovery_socket_t)
  (type swz_recovery_seed_t)
  (type swz_recovery_public_key_t)
  (allow swz_supervisor_t swz_recovery_socket_t (unix_stream_socket (create bind listen accept getattr read write)))
  (allow swz_supervisor_t swz_sshd_t (process (transition sigchld)))
  (allow swz_custodian_t swz_recovery_seed_t (file (open read getattr)))
  (allow swz_sshd_t swz_recovery_public_key_t (file (open read getattr)))
  (allow swz_bootstrap_t swz_recovery_socket_t (unix_stream_socket (connect read write getattr)))
  (allow swz_broker_t swz_recovery_socket_t (unix_stream_socket (connect read write getattr)))
  (allow swz_agent_t swz_recovery_runtime_t (file (create open read write getattr rename setattr)))
  (neverallow swz_dispatcher_t swz_recovery_seed_t (file (open read write create)))
  (neverallow swz_sshd_t swz_recovery_seed_t (file (open read write create)))
  (neverallow swz_bootstrap_t swz_recovery_seed_t (file (open read write create)))
  (neverallow swz_broker_t swz_recovery_seed_t (file (open read write create)))
  (neverallow swz_agent_t swz_recovery_seed_t (file (open read write create)))
)

